# =============================================================================
# dependencies - NGUON DUY NHAT (single source of truth) cho run.sh biet can tai gi.
# File nay vua de nguoi doc, vua duoc run.sh parse bang python3.
#
# CU PHAP: moi model la 1 block gom cac dong "KEY = VALUE",
#          cac block cach nhau bang 1 dong chi chua "---",
#          dong bat dau bang '#' la comment (bo qua).
#
# KIND co dung 3 gia tri:
#   hf  = tai ca repo bang huggingface snapshot_download  -> can REPO (repo_id)
#   git = git clone --depth 1                             -> can URL
#   url = tai 1 file don bang wget/curl                    -> can URL
#
# REVISION (tuy chon): ghim dung 1 commit de ket qua TAI LAP DUOC.
#   - KIND = hf : commit sha tren HuggingFace, truyen vao snapshot_download(revision=...).
#                 KHONG ghim thi moi lan chay tai ban moi nhat -> noi dung doi theo.
#   - KIND = git: commit sha, git fetch --depth 1 roi checkout --detach.
#   Bo trong = dung mac dinh (hf: nhanh main; git: HEAD cua lan clone).
#
# DEST luon la duong dan TINH DOI voi thu muc goc cua repo (khong dung / tuyet doi).
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Grounding DINO (tiny): text prompt -> bounding box cua vat the.
# -----------------------------------------------------------------------------
NAME = grounding-dino
KIND = hf
REPO = IDEA-Research/grounding-dino-tiny
DEST = model/grounding-dino-tiny
REVISION = a2bb814dd30d776dcf7e30523b00659f4f141c71
---
# -----------------------------------------------------------------------------
# 2) SAM (Segment Anything, vit-base): bounding box -> mask chinh xac.
# -----------------------------------------------------------------------------
NAME = sam
KIND = hf
REPO = facebook/sam-vit-base
DEST = model/sam-vit-base
REVISION = 70c1a07f894ebb5b307fd9eaaee97b9dfc16068f
---
# -----------------------------------------------------------------------------
# 3) MoGe-2 ViT-S Normal: metric depth + point cloud + intrinsics.
#    Ban ViT-S (35M params, ~141 MB weights) nhe hon rat nhieu so voi MoGe-3
#    ViT-L va phu hop hon voi Xavier 8 SM. MoGe-2 van co metric scale.
# -----------------------------------------------------------------------------
NAME = moge2
KIND = hf
REPO = Ruicheng/moge-2-vits-normal
DEST = model/moge-2-vits-normal
REVISION = 679230677b4d282c6f304189a93e98e14f085902
---
