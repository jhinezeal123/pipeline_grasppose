# inference path duoc pin tai commit phat hanh MoGe-2 va chay truc tiep tu source.
NAME = moge2-repo
KIND = git
URL = https://github.com/microsoft/MoGe.git
DEST = model/moge_repo
REVISION = 87ff6bbd4ee06588a5609ca7e913ca157509fe9d
---
# utils3d dependency cua MoGe-2. Import lazy, inference chi dung utils3d.torch.
NAME = utils3d-repo
KIND = git
URL = https://github.com/EasternJournalist/utils3d.git
DEST = model/utils3d_repo
REVISION = c5daf6f6c244d251f252102d09e9b7bcef791a38
---
# -----------------------------------------------------------------------------
# 5) GraspNetAPI source code (graspnet/graspnetAPI) - bat buoc dung ban git clone.
#    Goi "graspnetAPI" tren PyPI bi HONG (van import setuptools.extern.six da bi
#    Python moi xoa), nen run.sh clone repo nay va them vao PYTHONPATH.
# -----------------------------------------------------------------------------
NAME = graspnetapi-repo
KIND = git
URL = https://github.com/graspnet/graspnetAPI.git
DEST = model/graspnetAPI_repo
REVISION = eb57dd2092d8dbe05312a29c3d0c22f3226efbfc
---
# -----------------------------------------------------------------------------
# 6) Graspness checkpoint (GraspNet-1Billion), ban RealSense.
#
#    NGUON CHINH THUC (da kiem chung, khong phai suy doan):
#      repo  : https://github.com/graspnet/graspness_unofficial
#      README: muc "Model Weights" -> Google Drive
#      file  : minkuresunet_realsense.tar  (176 MB, ben trong co .pth)
#      link  : https://drive.google.com/file/d/1RfdpEM2y0x98rV28d7B2Dg8LLFKnBkfL/view
#      (ban Kinect: https://drive.google.com/file/d/10o5fc8LQsbI8H0pIC2RTJMNapW9eczqF/view)
#
#    DA DOI CHIEU NOI DUNG voi upstream — file ta dung dung la weight do:
#      epoch            = 10   (khop --checkpoint_path logs/log_kn/minkresunet_epoch10.tar
#                               trong command_test.sh cua upstream)
#      216 tham so, gom 4 nhanh graspable/rotation/crop/swad — bon ten nay CHI
#      co trong models/graspnet.py cua graspness_unofficial
#      md5 = f2c14a02cf024de789f324ba2da76277, 184.4 MB, luu dang zip
#      va quan trong nhat: chay ra ket qua dung (199 tu the, 108 vua khe kep 69 mm)
#
#    CACH TAI TU DONG: dataset Kaggle cong khai, da kiem chung tai duoc
#    KHONG can dang nhap (HTTP 200 voi isPrivate=false):
#      https://www.kaggle.com/datasets/bbucxi/graspness-realsense-ckpt
#    Day la ban sao cua dung file trong minkuresunet_realsense.tar o tren,
#    md5 f2c14a02cf024de789f324ba2da76277 / 184429769 byte.
#
#    LUU Y: link Google Drive KHONG tai truc tiep duoc — .../file/d/<id>/view chi
#    la trang xem, file >100 MB bi chan them buoc "Virus scan warning", va rat hay
#    gap "Quota exceeded". Do la ly do ton tai ban sao tren Kaggle.
# -----------------------------------------------------------------------------
NAME = graspness
KIND = url
URL = https://www.kaggle.com/api/v1/datasets/download/bbucxi/graspness-realsense-ckpt
DEST = model/graspness_reckpt.pth
MD5 = f2c14a02cf024de789f324ba2da76277

---
